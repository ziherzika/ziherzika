{
  "name": "ziherzika",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc",
    "build": "tsc -b && vite build",
    "build:api": "wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "typecheck": "tsc -b",
    "worker:types": "wrangler types --config worker/wrangler.jsonc worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "wrangler": "^4.124.0"
  },
  "type": "module"
}
